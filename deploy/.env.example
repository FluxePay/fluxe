# FLUXE Deployment Environment Variables
# Copy this file to .env and fill in your values

# ============ Ethereum Configuration ============
# Private key for deployer (with ETH for gas)
DEPLOYER_PRIVATE_KEY=0x...

# Address that will act as sequencer
SEQUENCER_ADDRESS=0x...

# RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# SP1 Verifier address (usually use gateway)
# Sepolia: 0x3B6041173B80E77f038f3F2C0f9744f04837185e
SP1_VERIFIER_ADDRESS=0x3B6041173B80E77f038f3F2C0f9744f04837185e

# ============ Solana Configuration ============
# Path to Solana keypair (default: ~/.config/solana/id.json)
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# Solana RPC URLs
SOLANA_DEVNET_URL=https://api.devnet.solana.com
SOLANA_MAINNET_URL=https://api.mainnet-beta.solana.com

# ============ Sequencer Configuration ============
# FLUXE L2 Chain ID (default: 989278 = 0xF1C5E)
FLUXE_CHAIN_ID=989278

# JSON-RPC server settings
FLUXE_HOST=0.0.0.0
FLUXE_PORT=8545
FLUXE_METRICS=true

# ============ SP1 Prover Configuration ============
# SP1 Network prover URL
SP1_PROVER_URL=https://prover.succinct.xyz

# SP1 API key (get from Succinct)
SP1_PROVER_KEY=

# ============ Monitoring ============
# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=fluxe-admin-password

# ============ Deployed Contract Addresses ============
# Fill these in after deployment
ETH_ROLLUP_ADDRESS=
ETH_BRIDGE_ADDRESS=
SOLANA_PROGRAM_ID=
