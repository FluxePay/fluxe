{
  "name": "@fluxe/sdk",
  "version": "0.1.0",
  "description": "Browser SDK for FLUXE privacy-preserving L2",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./prover": {
      "import": "./dist/prover/index.mjs",
      "require": "./dist/prover/index.js",
      "types": "./dist/prover/index.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet/index.mjs",
      "require": "./dist/wallet/index.js",
      "types": "./dist/wallet/index.d.ts"
    }
  },
  "files": [
    "dist",
    "circuits"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "idb-keyval": "^6.2.1",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/snarkjs": "^0.7.9",
    "eslint": "^9.5.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "fluxe",
    "zk",
    "privacy",
    "l2",
    "rollup",
    "snarkjs",
    "groth16"
  ],
  "author": "FLUXE Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluxe-network/fluxe"
  }
}
