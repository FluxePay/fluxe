# FLUXE Ethereum Contract Deployment Configuration

# Required: Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Required: RPC endpoints
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: Sequencer address (defaults to deployer if not set)
# SEQUENCER_ADDRESS=0x...

# Optional: Bridge chain ID (defaults to Sepolia 11155111)
# BRIDGE_CHAIN_ID=11155111

# Post-deployment: Contract addresses for verification and asset registration
# VERIFIER_ADDRESS=0x...
# ROLLUP_ADDRESS=0x...
# BRIDGE_ADDRESS=0x...

# Asset registration: Test token addresses on Sepolia
# WETH_ADDRESS=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9  # Sepolia WETH
# USDC_ADDRESS=0x...  # Sepolia USDC test token
